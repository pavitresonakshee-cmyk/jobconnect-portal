# Server Port (Render automatically assigns PORT; 5000 used locally)
PORT=5000

# MongoDB Connection String
# Local: mongodb://127.0.0.1:27017/jobconnect
# MongoDB Atlas (Render Deployment): mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/jobconnect?retryWrites=true&w=majority
MONGO_URI=mongodb://127.0.0.1:27017/jobconnect

# JWT Secret Key for Authentication
JWT_SECRET=jobconnect_jwt_secret_key_change_in_production

# Default Admin Account (seeded on first DB startup)
ADMIN_EMAIL=admin@jobconnect.com
ADMIN_PASSWORD=Admin@123
